      {
        "fecha": "2026-07-13T20:29:06.000+00:00",
        "detalle": "<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TIMES NEW ROMAN,TIMES,SERIF\"><SPAN STYLE=\"FONT-SIZE:18PX\">VISTOS<SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">.- AB. LUIS MIGUEL VARGAS TRUJILLO, EN CALIDAD DE JUEZ LA UNIDAD JUDICIAL CIVIL DEL CANT&OACUTE;N SANTO DOMINGO, PREVIENE EN EL CONOCIMIENTO DE LA PRESENTE DEMANDA DEBIDO AL SORTEO ELECTR&OACUTE;NICO REALIZADO, SE CONSIDERA:&NBSP;&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TIMES NEW ROMAN,TIMES,SERIF\"><SPAN STYLE=\"FONT-SIZE:18PX\">1.- <SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">LA DEMANDA QUE ANTECEDE ES CLARA, PRECISA Y CUMPLE LOS REQUISITOS LEGALES PREVISTOS EN LOS ART&IACUTE;CULOS 142 Y 143 DEL C&OACUTE;DIGO ORG&AACUTE;NICO GENERAL DE PROCESOS (COGEP) Y SE FUNDAMENTA EN PAGAR&EACUTE; A LA ORDEN, AL TENOR DE LO PREVISTO EN LOS ART&IACUTE;CULOS 347 NUMERAL 5 DEL MISMO C&OACUTE;DIGO; POR LO QUE SE CALIFICA Y ADMITE A TR&AACUTE;MITE MEDIANTE PROCEDIMIENTO EJECUTIVO.&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TIMES NEW ROMAN,TIMES,SERIF\"><SPAN STYLE=\"FONT-SIZE:18PX\">2.<SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">- SE ORDENA LA CITACI&OACUTE;N DE LA PARTE DEMANDADA LA SE&NTILDE;ORA </SPAN> HERNANDEZ OCAMPO JESSICA MARINA,<SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">&NBSP; PARA LO CUAL, POR SECRETARIA REM&IACUTE;TASE LAS BOLETAS RESPECTIVAS A LA OFICINA DE CITACIONES DE ESTA UNIDAD JUDICIAL, PREVIAMENTE LA PARTE ACTORA DEBER&AACUTE; PROVEER DE LAS COPIAS NECESARIAS PARA TAL FINALIDAD.&NBSP;&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TIMES NEW ROMAN,TIMES,SERIF\"><SPAN STYLE=\"FONT-SIZE:18PX\">3. - <SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">A LA PARTE DEMANDADA, UNA VEZ CITADA, SE LE CONCEDE EL T&EACUTE;RMINO DE QUINCE (15) D&IACUTE;AS PARA QUE CONTESTE LA DEMANDA EN LOS T&EACUTE;RMINOS QUE EXIGE EL ART&IACUTE;CULO 353 DEL COGEP, BAJO PREVENCI&OACUTE;N QUE DE NO HACERLO, SE PRONUNCIAR&AACUTE; INMEDIATAMENTE SENTENCIA DE CONFORMIDAD CON EL ART&IACUTE;CULO 352 DEL COGEP.</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TIMES NEW ROMAN,TIMES,SERIF\"><SPAN STYLE=\"FONT-SIZE:18PX\">4.- <SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">T&EACUTE;NGASE EN CUENTA LA CALIDAD EN LA QUE COMPARECE EL PROFESIONAL DEL DERECHO, EL CORREO ELECTR&OACUTE;NICO SE&NTILDE;ALADO PARA RECIBIR SUS NOTIFICACIONES Y LA DOCUMENTACI&OACUTE;N ACOMPA&NTILDE;ADA A LA DEMANDA. </SPAN>&NBSP;</SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TIMES NEW ROMAN,TIMES,SERIF\"><SPAN STYLE=\"FONT-SIZE:18PX\">5.-<SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">&NBSP;INTERVENGA LA AB. NARV&AACUTE;EZ JARA NATASHA EN CALIDAD DE SECRETARIA TITULAR DE ESTA UNIDAD JUDICIAL.&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TIMES NEW ROMAN,TIMES,SERIF\"><SPAN STYLE=\"FONT-SIZE:18PX\">6.- NOTIF&IACUTE;QUESE Y C&UACUTE;MPLASE. &NDASH;</SPAN></SPAN></P>",
