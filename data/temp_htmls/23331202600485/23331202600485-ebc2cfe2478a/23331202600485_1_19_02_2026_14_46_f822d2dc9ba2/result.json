      {
        "fecha": "2026-04-09T20:03:24.000+00:00",
        "detalle": "<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TAHOMA,GENEVA,SANS-SERIF\"><SPAN STYLE=\"FONT-SIZE:16PX\"><STRONG><STRONG>VISTOS.- </STRONG></STRONG><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">AB. LUIS MIGUEL VARGAS TRUJILLO, EN CALIDAD DE JUEZ LA UNIDAD JUDICIAL CIVIL DEL CANT&OACUTE;N SANTO DOMINGO, PREVIENE EN EL CONOCIMIENTO DE LA PRESENTE DEMANDA DEBIDO AL SORTEO ELECTR&OACUTE;NICO REALIZADO, SE CONSIDERA:&NBSP;&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TAHOMA,GENEVA,SANS-SERIF\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">1.-LA DEMANDA QUE ANTECEDE ES CLARA, PRECISA Y CUMPLE LOS REQUISITOS LEGALES PREVISTOS EN EL ART&IACUTE;CULO 142 Y 143 DEL C&OACUTE;DIGO ORG&AACUTE;NICO GENERAL DE PROCESOS (COGEP) Y SE FUNDAMENTA EN LETRA DE CAMBIO, AL TENOR DE LO PREVISTO EN EL ART&IACUTE;CULO 347 NUMERAL 4 DEL MISMO C&OACUTE;DIGO; POR LO QUE SE CALIFICA Y ADMITE A TR&AACUTE;MITE MEDIANTE PROCEDIMIENTO EJECUTIVO.&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TAHOMA,GENEVA,SANS-SERIF\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">2.- SE ORDENA LA CITACI&OACUTE;N DE LA PARTE DEMANDADA </SPAN><EM>SE&NTILDE;ORA <STRONG>GONZALEZ PINELA ANGEL ANDERSON</STRONG></EM><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\"><STRONG>,</STRONG>&NBSP; PARA LO CUAL, POR SECRETARIA, REM&IACUTE;TASE LAS BOLETAS RESPECTIVAS A LA OFICINA DE CITACIONES DE ESTA UNIDAD JUDICIAL; PREVIAMENTE, LA PARTE ACTORA DEBER&AACUTE; PROVEER DE LAS COPIAS NECESARIAS PARA TAL FINALIDAD.&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TAHOMA,GENEVA,SANS-SERIF\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">3. - A LA PARTE DEMANDADA, UNA VEZ CITADA, SE LE CONCEDE EL T&EACUTE;RMINO DE QUINCE (15) D&IACUTE;AS PARA QUE CONTESTE LA DEMANDA EN LOS T&EACUTE;RMINOS QUE EXIGE EL ART&IACUTE;CULO 353 DEL COGEP, BAJO PREVENCI&OACUTE;N QUE DE NO HACERLO, SE PRONUNCIAR&AACUTE; INMEDIATAMENTE SENTENCIA DE CONFORMIDAD CON EL ART&IACUTE;CULO 352 DEL COGEP.</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TAHOMA,GENEVA,SANS-SERIF\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">4.- T&EACUTE;NGASE EN CUENTA LA CALIDAD EN LA QUE COMPARECE EL PROFESIONAL DEL DERECHO, EL CORREO ELECTR&OACUTE;NICO SE&NTILDE;ALADO PARA RECIBIR SUS NOTIFICACIONES Y LA DOCUMENTACI&OACUTE;N ACOMPA&NTILDE;ADA A LA DEMANDA.&NBSP;&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TAHOMA,GENEVA,SANS-SERIF\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">5.- DESGL&OACUTE;SESE Y ENTR&EACUTE;GUESE LA DOCUMENTACI&OACUTE;N ACOMPA&NTILDE;ADA LA DEMANDA PREVIAMENTE DEJANDO COPIAS CERTIFICADAS EN EL PROCESO, EN LA FORMA SOLICITADA POR LA PARTE EJECUTANTE. A EXCEPCI&OACUTE;N DEL T&IACUTE;TULO EJECUTIVO (LETRA DE CAMBIO) QUE SE ENTREGAR&AACUTE; UNA VEZ SE DICTE SENTENCIA.</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TAHOMA,GENEVA,SANS-SERIF\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">6.- INTERVENGA LA AB. NARV&AACUTE;EZ JARA NATASHA EN CALIDAD DE SECRETARIA TITULAR DE ESTA UNIDAD JUDICIAL.&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-FAMILY:TAHOMA,GENEVA,SANS-SERIF\"><SPAN STYLE=\"FONT-SIZE:16PX\"><STRONG><STRONG>7.- NOTIF&IACUTE;QUESE Y C&UACUTE;MPLASE. &NDASH;</STRONG></STRONG></SPAN></SPAN></P>\n\n<P>&NBSP;</P>",
