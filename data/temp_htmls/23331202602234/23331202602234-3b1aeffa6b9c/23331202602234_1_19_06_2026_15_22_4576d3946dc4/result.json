        "ORIGEN_DATA": "API+DOM"
      },
      {
        "fecha": "2026-07-14T21:41:42.000+00:00",
        "detalle": "<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\"><STRONG>VISTOS</STRONG>.- ABG. KARINA ARACELY VEL&AACUTE;SQUEZ PURUNCAJA, EN CALIDAD DE JUEZA DE ESTA UNIDAD JUDICIAL CIVIL CON SEDE EN EL CANT&OACUTE;N SANTO DOMINGO, PUESTO QUE HA SIDO A MI VISTA EL EXPEDIENTE EL D&IACUTE;A DE HOY, AVOCO CONOCIMIENTO DE LA PRESENTE DEMANDA EN LEGAL Y DEBIDA FORMA, POR EL SORTEO ELECTR&OACUTE;NICO DE LEY, SE <STRONG>CONSIDERA</STRONG>:&NBSP;&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">1.- LA DEMANDA QUE ANTECEDE ES CLARA, PRECISA Y CUMPLE LOS REQUISITOS LEGALES PREVISTOS EN LOS ART&IACUTE;CULOS 142 Y 143 DEL C&OACUTE;DIGO ORG&AACUTE;NICO GENERAL DE PROCESOS (COGEP) Y SE FUNDAMENTA EN PAGAR&EACUTE; A LA ORDEN, AL TENOR DE LO PREVISTO EN LOS ART&IACUTE;CULOS 347 NUMERAL 5 DEL MISMO C&OACUTE;DIGO; POR LO QUE SE CALIFICA Y ADMITE A TR&AACUTE;MITE MEDIANTE PROCEDIMIENTO <STRONG>EJECUTIVO</STRONG>.&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">2.- SE ORDENA LA CITACI&OACUTE;N DE LA PARTE DEMANDADA:&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-SIZE:18PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><STRONG>2.1.-&NBSP;&NBSP;CHILA CARVACHE CRISTHIAN FERNANDO,</STRONG></SPAN></SPAN><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">&NBSP;</SPAN><SPAN STYLE=\"BACKGROUND-COLOR:#FFFFFF; COLOR:#000000\">EN EL LUGAR QUE SE INDICA EN LA DEMANDA, </SPAN><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">PARA LO CUAL SE ADJUNTAR&AACUTE; LA DEMANDA, COPIA CERTIFICADA DE LOS DOCUMENTOS ADJUNTOS Y ESTE AUTO INICIAL. LA PARTE ACTORA PROPORCIONE LAS COPIAS NECESARIAS A FIN DE ELABORAR LOS JUEGOS DE CITACI&OACUTE;N.&NBSP;&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">3. - A LA PARTE DEMANDADA, UNA VEZ CITADA, SE LE CONCEDE EL T&EACUTE;RMINO DE QUINCE (15) D&IACUTE;AS PARA QUE CONTESTE LA DEMANDA EN LOS T&EACUTE;RMINOS QUE EXIGE EL ART&IACUTE;CULO 353 DEL COGEP, BAJO PREVENCI&OACUTE;N QUE DE NO HACERLO, SE PRONUNCIAR&AACUTE; INMEDIATAMENTE SENTENCIA DE CONFORMIDAD CON EL ART&IACUTE;CULO 352 DEL COGEP.</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">4.- T&EACUTE;NGASE EN CUENTA LA CALIDAD EN LA QUE COMPARECE EL PROFESIONAL DEL DERECHO, EL CORREO ELECTR&OACUTE;NICO SE&NTILDE;ALADO PARA RECIBIR SUS NOTIFICACIONES Y LA DOCUMENTACI&OACUTE;N ACOMPA&NTILDE;ADA A LA DEMANDA.&NBSP;&NBSP;</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">5.- DESGL&OACUTE;SESE Y ENTR&EACUTE;GUESE LA DOCUMENTACI&OACUTE;N ACOMPA&NTILDE;ADA LA DEMANDA PREVIAMENTE DEJANDO COPIAS CERTIFICADAS EN EL PROCESO, EN LA FORMA SOLICITADA POR LA PARTE EJECUTANTE. A EXCEPCI&OACUTE;N DEL T&IACUTE;TULO EJECUTIVO (PAGAR&EACUTE; A LA ORDEN) QUE SE ENTREGAR&AACUTE; UNA VEZ SE DICTE SENTENCIA, T&OACUTE;MESE EN CUENTA LA AUTORIZACI&OACUTE;N A LA ABG. IVANNA CAMPOVERDE PARA SU CUMPLIMIENTO.</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">6.-&NBSP;INTERVIENE EN LA PRESENTE CAUSA EL AB. FABI&AACUTE;N BELTR&AACUTE;N, EN CALIDAD DE SECRETARIO TITULAR DE ESTA UNIDAD JUDICIAL.</SPAN></SPAN></SPAN></P>\n\n<P STYLE=\"TEXT-ALIGN:JUSTIFY\"><STRONG><SPAN STYLE=\"FONT-SIZE:16PX\"><SPAN STYLE=\"FONT-FAMILY:ARIAL,HELVETICA,SANS-SERIF\"><SPAN STYLE=\"BACKGROUND-COLOR:TRANSPARENT; COLOR:#000000\">7.- NOTIF&IACUTE;QUESE Y C&UACUTE;MPLASE. -</SPAN></SPAN></SPAN></STRONG></P>",
